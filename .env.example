# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Instructions for beginners:
# 1. Copy this file and rename it to `.env` in the same directory.
# 2. Fill in your actual values in `.env`.
# 3. NEVER commit your `.env` file or passwords to GitHub! (.gitignore protects it)

# Horizon Plus Login Credentials (for automation/login_test.py)
HORIZON_USERNAME=your_email_or_username_here
HORIZON_PASSWORD=your_password_here

# Flask Web Server Settings
PORT=5000
FLASK_DEBUG=False

# Playwright Browser Automation Settings
# Set to 'false' if you want to visually watch the browser during automation
PLAYWRIGHT_HEADLESS=true
